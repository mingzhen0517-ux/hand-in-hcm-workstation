# ==========================================
# 1. 数据库配置
# ==========================================
# 本地单机部署默认使用本地 SQLite 文件:
DATABASE_URL="file:./dev.db"

# 若部署至 Cloudflare + Turso 云端环境，请填入 Turso 数据库地址及认证 Token:
# TURSO_DATABASE_URL="libsql://your-db-name.turso.io"
# TURSO_AUTH_TOKEN="your-turso-auth-token"

# ==========================================
# 2. 大语言模型配置 (本地部署请填写您自有的 API Key)
# ==========================================
# 支持 OpenAI 官方、Azure、DeepSeek、Moonshot、通义千问等所有兼容 OpenAI 格式的接口
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o"
